+//
+// RT64
+//
+
+#pragma once
+
+#include "rt64_gbi.h"
+
+// Conker's Bad Fur Day's modified F3DEX2: F3DEX2 with a different lighting
+// model (point lights, per-vertex normals held apart from the vertices, a
+// coordinate modifier) and a four-triangle command.
+#define F3DEX2CBFD_G_TRI4 0x10
+#define F3DEX2CBFD_G_MV_NORMALES 14
+#define F3DEX2CBFD_G_MW_COORD_MOD 0x10
+
+namespace RT64 {
+    namespace GBI_F3DEX2CBFD {
+        void setup(GBI *gbi);
+    };
+};
diff --git a/src/hle/rt64_rsp.cpp b/src/hle/rt64_rsp.cpp
index 1da2550..4672149 100644
--- a/src/hle/rt64_rsp.cpp
+++ b/src/hle/rt64_rsp.cpp
@@ -4,7 +4,9 @@
 
 #include "rt64_rsp.h"
 
+#include <algorithm>
 #include <cassert>
+#include <cmath>
 
 #include "../include/rt64_extended_gbi.h"
 #include "common/rt64_common.h"
@@ -427,6 +429,155 @@ namespace RT64 {
         setVertexCommon<false, sizeof(VertexEXV1)>(rdramAddress, dstIndex, dstIndex + vtxCount);
     }
 
+    // Conker's Bad Fur Day (F3DEX2CBFD). Based on GLideN64's implementation.
+
+    void RSP::setVertexCBFD(uint32_t address, uint32_t vtxCount, uint32_t dstIndex) {
+        if ((dstIndex >= RSP_MAX_VERTICES) || ((dstIndex + vtxCount) > RSP_MAX_VERTICES)) {
+            assert(false && "Vertex indices are not valid. DL is possibly corrupted.");
+            return;
+        }
+
+        const uint32_t rdramAddress = fromSegmentedMasked(address);
+        const Vertex *dlVerts = reinterpret_cast<const Vertex *>(state->fromRDRAM(rdramAddress));
+        memcpy(&vertices[dstIndex], dlVerts, sizeof(Vertex) * vtxCount);
+        if (cbfd.lighting) {
+            lightVerticesCBFD(dstIndex, vtxCount);
+        }
+
+        setVertexCommon<true, sizeof(Vertex)>(rdramAddress, dstIndex, dstIndex + vtxCount);
+    }
+
+    void RSP::setLightCBFD(uint32_t index, uint32_t address) {
+        if (index >= cbfd.lights.size()) {
+            return;
+        }
+
+        // Light layout (big-endian offsets): colour r,g,b at 0-2, direction x,y,z (s8) at 8-10,
+        // attenuation at 12, position x,y,z (s16) at 32-37.
+        const uint32_t rdramAddress = fromSegmentedMasked(address);
+        const uint8_t *data = state->fromRDRAM(rdramAddress);
+        auto byteAt = [&](uint32_t offset) { return data[offset ^ 3]; };
+        auto shortAt = [&](uint32_t offset) { return *reinterpret_cast<const int16_t *>(&data[offset ^ 2]); };
+        CBFDLight &light = cbfd.lights[index];
+        light.r = byteAt(0) / 255.0f;
+        light.g = byteAt(1) / 255.0f;
+        light.b = byteAt(2) / 255.0f;
+        float dx = int8_t(byteAt(8)), dy = int8_t(byteAt(9)), dz = int8_t(byteAt(10));
+        float len = std::sqrt(dx * dx + dy * dy + dz * dz);
+        if (len > 0.0f) {
+            dx /= len; dy /= len; dz /= len;
+        }
+        light.dir[0] = dx;
+        light.dir[1] = dy;
+        light.dir[2] = dz;
+        light.pos[0] = shortAt(32);
+        light.pos[1] = shortAt(34);
+        light.pos[2] = shortAt(36);
+        light.ca = byteAt(12) / 16.0f;
+    }
+
+    void RSP::setCoordModCBFD(uint32_t w0, uint32_t w1) {
+        if ((w0 & 8) != 0) {
+            return;
+        }
+
+        const uint32_t idx = (w0 >> 1) & 3;
+        const uint32_t pos = w0 & 0x30;
+        auto &mod = cbfd.coordMod;
+        if (pos == 0x00) {
+            mod[0 + idx] = float(int16_t(w1 >> 16));
+            mod[1 + idx] = float(int16_t(w1 & 0xFFFF));
+        }
+        else if (pos == 0x10) {
+            mod[4 + idx] = float(w1 >> 16) / 65536.0f;
+            mod[5 + idx] = float(w1 & 0xFFFF) / 65536.0f;
+            mod[12 + idx] = mod[0 + idx] + mod[4 + idx];
+            mod[13 + idx] = mod[1 + idx] + mod[5 + idx];
+        }
+        else if (pos == 0x20) {
+            mod[8 + idx] = float(int16_t(w1 >> 16));
+            mod[9 + idx] = float(int16_t(w1 & 0xFFFF));
+        }
+    }
+
+    void RSP::lightVerticesCBFD(uint32_t dstIndex, uint32_t vtxCount) {
+        const int numLights = int(std::min<uint32_t>(cbfd.lightCount, uint32_t(cbfd.lights.size() - 1)));
+        const auto &mod = cbfd.coordMod;
+        const uint32_t geometryMode = geometryModeStack[geometryModeStackSize - 1];
+        const bool pointLighting = (geometryMode & G_POINT_LIGHTING) != 0;
+
+        // Directional lights in model space: the modelview's rotation applied inversely.
+        hlslpp::float3 lightDirs[12];
+        const hlslpp::float4x4 &modelView = modelMatrixStack[modelMatrixStackSize - 1];
+        for (int l = 0; l < numLights; l++) {
+            const CBFDLight &light = cbfd.lights[l];
+            hlslpp::float4 d = hlslpp::mul(modelView, hlslpp::float4(light.dir[0], light.dir[1], light.dir[2], 0.0f));
+            hlslpp::float3 d3 = d.xyz;
+            float len = hlslpp::length(d3);
+            lightDirs[l] = (len > 0.0f) ? (d3 / len) : hlslpp::float3(0.0f, 0.0f, 0.0f);
+        }
+
+        const uint8_t *rdram = state->fromRDRAM(0);
+        for (uint32_t i = dstIndex; i < dstIndex + vtxCount; i++) {
+            Vertex &vtx = vertices[i];
+            if (int16_t(vtx.flag) < 0) {
+                continue;
+            }
+
+            const float px = (vtx.x + mod[8]) * mod[12];
+            const float py = (vtx.y + mod[9]) * mod[13];
+            const float pz = (vtx.z + mod[10]) * mod[14];
+
+            // The ambient colour follows the last light.
+            float r = cbfd.lights[numLights].r;
+            float g = cbfd.lights[numLights].g;
+            float b = cbfd.lights[numLights].b;
+
+            hlslpp::float3 normal(0.0f, 0.0f, 0.0f);
+            int l = numLights - 1;
+            if (cbfd.advancedLighting) {
+                const uint32_t normalAddress = cbfd.normalBase + (i << 1);
+                normal = hlslpp::float3(
+                    float(int8_t(rdram[(normalAddress + 0) ^ 3])) / 127.0f,
+                    float(int8_t(rdram[(normalAddress + 1) ^ 3])) / 127.0f,
+                    float(int8_t(vtx.flag & 0xFF)) / 127.0f);
+
+                // The last light is directional.
+                if (l >= 0) {
+                    float intensity = std::min(1.0f, float(hlslpp::dot(normal, lightDirs[l])));
+                    if (intensity > 0.0f) {
+                        r += cbfd.lights[l].r * intensity;
+                        g += cbfd.lights[l].g * intensity;
+                        b += cbfd.lights[l].b * intensity;
+                    }
+                }
+            }
+
+            // The others are point lights.
+            for (l = numLights - 2; l >= 0; l--) {
+                const CBFDLight &light = cbfd.lights[l];
+                const float vx = px - light.pos[0];
+                const float vy = py - light.pos[1];
+                const float vz = pz - light.pos[2];
+                const float len = 2.0f * (vx * vx + vy * vy + vz * vz) / 65536.0f;
+                float intensity = (len > 0.0f) ? std::min(1.0f, light.ca / len) : 1.0f;
+                if (cbfd.advancedLighting && pointLighting) {
+                    intensity *= std::min(1.0f, float(hlslpp::dot(normal, lightDirs[l])));
+                }
+
+                if (intensity > 0.0f) {
+                    r += light.r * intensity;
+                    g += light.g * intensity;
+                    b += light.b * intensity;
+                }
+            }
+
+            vtx.color.r = uint8_t(std::min(1.0f, r) * vtx.color.r);
