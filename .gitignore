# N64Recomp output and intermediates (regenerate with `wsl sh recomp/run.sh`)
/RecompiledFuncs/
/recomp/conker.us.recomp.elf
/recomp/n64recomp.out
/recomp/n64recomp.err
/host/build/
/conker_data/
/host/build-win/
/host/build-win-log.txt
__pycache__/
/tools/BanjoRecomp/
/tools/BKRecompModTemplate/
# Mod symbol files (regenerated by recomp/run.sh) and mod build output
/mods/syms/
/mods/*/build/
/mods/dist/
# Nothing from the game itself: ROMs, saves, and anything extracted from them
*.z64
*.n64
*.v64
*.bin
*.eep
/host/user_save.bin
/.claude/
